# ==========================================
# FortSight AI Production Environment Secrets
# ==========================================

# Database Secrets
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=fortsight_prod

# Application Config
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=your_secure_random_secret_key_here

# API Keys (Keep these secure and out of version control)
GEMINI_API_KEY=your_production_gemini_api_key_here

# Gunicorn Configuration
# WORKERS_PER_CORE=1 # Adjust based on CPU and RAM
# MAX_WORKERS=4      # Maximum number of Uvicorn workers

# CORS Config (If needed)
BACKEND_CORS_ORIGINS=["https://your-production-domain.com"]
